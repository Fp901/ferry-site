---
import Layout from '../layouts/Layout.astro';
import { breadcrumbSchema } from '../lib/schema';

const cooked = [
  { name: "The Ferry Breakfast",      desc: "Suffolk sausage, bacon, hash brown, beans, sautéed mushrooms, fried egg, toast & butter" },
  { name: "Vegetarian Breakfast",     desc: "Vegetarian sausage, hash brown, beans, sautéed mushrooms, fried egg, toast & butter" },
  { name: "Three Egg Omelette",       desc: "Choice of Suffolk ham, mature cheddar or mushroom, with beans, toast & butter" },
  { name: "Scrambled Eggs on Toast",  desc: "Add smoked bacon if you like" },
  { name: "Heinz Baked Beans on Toast", desc: "A simple classic" },
];

const rolls = [
  "Suffolk Bacon", "Suffolk Sausage", "Bacon & Egg", "Sausage & Egg",
  "Sausage & Bacon", "Sausage, Bacon & Egg", "Free Range Fried Egg", "Vegetarian/Vegan Sausage",
];

const faqs = [
  { q: "What time is breakfast served?", a: "Breakfast and our artisan breakfast rolls are served until midday, every day we're open: Wednesday to Friday from 11am, and Saturday & Sunday from 10am. The cafe is closed Monday and Tuesday, except on bank holiday Mondays." },
  { q: "Do you do a full English breakfast?", a: "Yes. The Ferry Breakfast is our full cooked breakfast: Suffolk sausage, bacon, hash brown, beans, sautéed mushrooms, a fried egg, and toast & butter. There is a vegetarian version too." },
  { q: "Do you have vegetarian or vegan breakfast options?", a: "Yes. A vegetarian breakfast plate, vegetarian/vegan sausage breakfast rolls, and eggs on toast are all available. Just ask at the counter." },
  { q: "Where can I get breakfast by the sea in Felixstowe?", a: "At The Ferry Cafe, Felixstowe Ferry (IP11 9RZ), overlooking the River Deben estuary in Old Felixstowe. Dog friendly, with parking beside the cafe." },
];

const breadcrumbs = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Breakfast", path: "/breakfast" },
]);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
};
---
<Layout
  title="Breakfast in Felixstowe | The Ferry Cafe, Felixstowe Ferry"
  description="Cooked breakfast in Felixstowe, served until midday at Felixstowe Ferry. The Ferry Breakfast, veggie & vegan options and artisan bacon & sausage rolls, with sea views over the River Deben."
  canonical="/breakfast"
  ogImage="https://theferry.cafe/assets/food-breakfast.webp"
  ogImageAlt="Full cooked breakfast at The Ferry Cafe, Felixstowe Ferry"
  schemas={[breadcrumbs, faqSchema]}
>
  <main id="main-content" class="flex-grow">

    <!-- Photo hero -->
    <div class="relative text-white py-20 sm:py-28 overflow-hidden">
      <img
        src="/assets/food-breakfast.webp"
        alt="Full cooked breakfast with a seaside view at The Ferry Cafe, Felixstowe Ferry"
        width="800" height="600"
        loading="eager" decoding="async"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-brand-navy/75" aria-hidden="true"></div>
      <div class="relative container mx-auto px-4">
        <p class="text-sky-200 text-sm mb-1">
          <a href="/" class="hover:underline">Home</a> &rsaquo; Breakfast
        </p>
        <h1 class="text-4xl sm:text-5xl font-extrabold">Breakfast at The Ferry Cafe</h1>
        <p class="text-white/80 text-sm sm:text-base mt-3 max-w-2xl">
          A proper cooked breakfast by the sea at Felixstowe Ferry, made with locally sourced Suffolk ingredients and served until midday.
        </p>
      </div>
    </div>

    <!-- Intro -->
    <section class="py-14" aria-labelledby="intro-heading">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 id="intro-heading" class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-5">Breakfast in Felixstowe, right on the water</h2>
        <div class="space-y-4 text-gray-600 leading-relaxed">
          <p>
            Start the day by the sea. The Ferry Cafe serves a proper <strong>cooked breakfast in Felixstowe</strong>
            from our spot at <strong>Felixstowe Ferry</strong>, made with locally sourced Suffolk ingredients and
            <strong>served until midday</strong>, every day we're open.
          </p>
          <p>
            Whether it's the full <strong>Ferry Breakfast</strong>, a veggie or vegan plate, or a warm artisan bacon
            roll with a mug of tea, you'll eat it looking out over the <strong>River Deben estuary</strong> in our
            1950s seaside diner. Dogs always welcome.
          </p>
        </div>
      </div>
    </section>

    <!-- Cooked breakfasts -->
    <section class="bg-gray-50 py-14" aria-labelledby="cooked-heading">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 id="cooked-heading" class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-1">Cooked breakfasts</h2>
        <p class="text-gray-500 mb-8 text-sm">Served until midday.</p>
        <div class="grid sm:grid-cols-2 gap-3">
          {cooked.map(d => (
            <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
              <p class="font-bold text-brand-navy">{d.name}</p>
              <p class="text-sm text-gray-500 mt-0.5 leading-snug">{d.desc}</p>
            </div>
          ))}
        </div>

        <h3 class="text-xl font-bold text-brand-navy mt-10 mb-1">Artisan breakfast rolls</h3>
        <p class="text-gray-500 mb-5 text-sm">On a roll handcrafted by The Friendly Loaf Bakery, Bury St Edmunds. Served until midday.</p>
        <div class="flex flex-wrap gap-2">
          {rolls.map(r => (
            <span class="bg-white border border-gray-200 rounded-full px-3.5 py-1.5 text-sm text-gray-700">{r}</span>
          ))}
        </div>

        <div class="mt-8">
          <a href="/menu/" class="inline-block px-7 py-3 bg-brand-navy hover:bg-[#243f52] text-white font-bold rounded-full shadow transition-colors">
            See the full menu &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Local sourcing + times -->
    <section class="py-14" aria-labelledby="local-heading">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 id="local-heading" class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-8">Locally sourced, by the sea</h2>
        <div class="grid sm:grid-cols-2 gap-6">
          <div class="bg-sky-50 rounded-2xl p-6">
            <h3 class="font-bold text-brand-navy mb-2">🐟 Suffolk ingredients</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              We work with local Suffolk suppliers wherever possible, from the eggs and Suffolk sausages to artisan
              rolls handcrafted by The Friendly Loaf Bakery.
            </p>
          </div>
          <div class="bg-sky-50 rounded-2xl p-6">
            <h3 class="font-bold text-brand-navy mb-2">🌊 A view with your fry-up</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Eat overlooking the River Deben estuary in our retro 1950s diner, or out on the dog-friendly terrace on
              a bright morning.
            </p>
          </div>
        </div>

        <!-- Serving times callout -->
        <div class="mt-8 bg-brand-navy text-white rounded-2xl p-6">
          <h3 class="font-bold text-sky-300 text-xs uppercase tracking-widest mb-3">Breakfast serving times</h3>
          <p class="text-sm leading-relaxed">
            Served <strong>until midday</strong>, every day we're open.
            Wednesday to Friday from 11am, Saturday &amp; Sunday from 10am.
            Closed Monday and Tuesday, except on bank holiday Mondays.
          </p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href="tel:+441394276305" class="text-xs font-semibold bg-white/15 hover:bg-white/25 px-4 py-2 rounded-full transition-colors">Call 01394 276305</a>
            <a href="/contact/" class="text-xs font-semibold bg-white/15 hover:bg-white/25 px-4 py-2 rounded-full transition-colors">Find us &amp; opening hours</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-gray-50 py-14" aria-labelledby="faq-heading">
      <div class="container mx-auto px-4 max-w-2xl">
        <h2 id="faq-heading" class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-8 text-center">Breakfast FAQs</h2>
        <dl class="space-y-6">
          {faqs.map(item => (
            <div class="border-b border-gray-200 pb-5">
              <dt class="font-bold text-brand-navy mb-1">{item.q}</dt>
              <dd class="text-sm text-gray-600 leading-relaxed">{item.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- CTA -->
    <section class="container mx-auto px-4 py-14 text-center" aria-label="Call to action">
      <h2 class="text-2xl font-bold text-gray-800 mb-3">Come for breakfast</h2>
      <p class="text-gray-500 mb-7 max-w-md mx-auto text-sm sm:text-base">
        Find us at Felixstowe Ferry, Suffolk IP11 9RZ. Breakfast served until midday, Wednesday to Sunday.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/menu/" class="px-7 py-3 bg-primary hover:bg-sky-600 text-white font-bold rounded-lg shadow transition-colors">See Our Menu</a>
        <a href="https://maps.google.com/?q=The+Ferry+Cafe+Felixstowe+Ferry+IP11+9RZ" target="_blank" rel="noopener noreferrer" class="px-7 py-3 border-2 border-primary text-primary hover:bg-sky-50 font-bold rounded-lg transition-colors">Get Directions</a>
      </div>
    </section>

  </main>

  <!-- Mobile sticky bar -->
  <div class="fixed bottom-0 inset-x-0 z-50 sm:hidden bg-white border-t border-gray-200 shadow-2xl" aria-label="Quick contact">
    <div class="grid grid-cols-2 divide-x divide-gray-200">
      <a href="tel:+441394276305" class="flex items-center justify-center gap-2 py-3.5 text-primary font-bold text-sm active:bg-sky-50">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        Call Us
      </a>
      <a href="/menu/" class="flex items-center justify-center gap-2 py-3.5 bg-primary text-white font-bold text-sm active:bg-sky-600">
        See Menu
      </a>
    </div>
  </div>
  <div class="h-14 sm:hidden" aria-hidden="true"></div>
</Layout>
