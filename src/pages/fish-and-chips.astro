---
import Layout from '../layouts/Layout.astro';
import { breadcrumbSchema } from '../lib/schema';

const dishes = [
  { name: "Cod & Chips",              desc: "Hand-battered fresh cod fillet with chunky chips" },
  { name: "Haddock & Chips",          desc: "Hand-battered haddock with chunky chips" },
  { name: "Plaice & Chips",           desc: "A Felixstowe Ferry favourite, battered to order" },
  { name: "Wholetail Scampi & Chips", desc: "Whole scampi tails with chunky chips" },
  { name: "Grilled Sea Bass & Chips", desc: "Freshly grilled sea bass (subject to availability)" },
  { name: "Half Portion Cod & Chips", desc: "A smaller portion, ideal for lighter appetites" },
];

const faqs = [
  { q: "What time do you serve fish & chips?", a: "Fish & chips are served from midday until the kitchen closes at 2pm, Wednesday to Sunday (mornings are for breakfast until midday). The cafe stays open until 3pm." },
  { q: "Do you do takeaway fish & chips?", a: "Yes. Eat in overlooking the River Deben, or take your fish & chips away to enjoy on the shingle beach right by the water at Felixstowe Ferry." },
  { q: "What fish do you serve?", a: "Cod, haddock, plaice and wholetail scampi, plus grilled sea bass when available. Everything is hand-battered to order and served with chunky chips, garden peas and homemade tartare sauce. All fish is subject to daily availability." },
  { q: "Where in Felixstowe are you?", a: "We're at Felixstowe Ferry, Suffolk IP11 9RZ, at the mouth of the River Deben in Old Felixstowe, with parking right beside the cafe and public toilets opposite." },
  { q: "Is The Ferry Cafe dog friendly?", a: "Yes, dogs are always welcome, especially out on the terrace overlooking the estuary." },
];

const breadcrumbs = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Fish & Chips", path: "/fish-and-chips" },
]);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
};
---
<Layout
  title="Fish & Chips at Felixstowe Ferry | The Ferry Cafe"
  description="Fresh, hand-battered fish & chips at Felixstowe Ferry since 1953. Cod, haddock, plaice, scampi & grilled sea bass with chunky chips, garden peas & homemade tartare. Dine in or takeaway, served from midday."
  canonical="/fish-and-chips"
  ogImage="https://theferry.cafe/assets/food-fish-chips.webp"
  ogImageAlt="Hand-battered fish and chips at The Ferry Cafe, Felixstowe Ferry"
  schemas={[breadcrumbs, faqSchema]}
>
  <main id="main-content" class="flex-grow">

    <!-- Photo hero -->
    <div class="relative text-white py-20 sm:py-28 overflow-hidden">
      <img
        src="/assets/food-fish-chips.webp"
        alt="Hand-battered fish and chips with chunky chips at The Ferry Cafe, Felixstowe Ferry"
        width="800" height="600"
        loading="eager" decoding="async"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-brand-navy/75" aria-hidden="true"></div>
      <div class="relative container mx-auto px-4">
        <p class="text-sky-200 text-sm mb-1">
          <a href="/" class="hover:underline">Home</a> &rsaquo; Fish &amp; Chips
        </p>
        <h1 class="text-4xl sm:text-5xl font-extrabold">Fish &amp; Chips at Felixstowe Ferry</h1>
        <p class="text-white/80 text-sm sm:text-base mt-3 max-w-2xl">
          Hand-battered to order and fried fresh, served with chunky chips, garden peas and homemade tartare sauce, right on the water since 1953.
        </p>
      </div>
    </div>

    <!-- Intro -->
    <section class="py-14" aria-labelledby="intro-heading">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 id="intro-heading" class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-5">Felixstowe's fish &amp; chips, done properly</h2>
        <div class="space-y-4 text-gray-600 leading-relaxed">
          <p>
            The Ferry Cafe has served some of <strong>Felixstowe's best-loved fish &amp; chips</strong> from the
            water's edge at <strong>Felixstowe Ferry</strong> since 1953. Every piece of fish is
            <strong>hand-battered to order</strong> and fried fresh, then piled up with chunky chips, garden peas
            and our homemade tartare sauce.
          </p>
          <p>
            Whether you sit in overlooking the <strong>River Deben estuary</strong> or take your fish &amp; chips
            down to the shingle by the water, this is the Felixstowe Ferry classic that keeps generations of
            sailors, dog walkers and day trippers coming back.
          </p>
        </div>
      </div>
    </section>

    <!-- The menu -->
    <section class="bg-gray-50 py-14" aria-labelledby="menu-heading">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 id="menu-heading" class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-1">On the fish &amp; chips menu</h2>
        <p class="text-gray-500 mb-8 text-sm">Served from midday. All fish subject to availability, with garden peas &amp; homemade tartare sauce.</p>
        <div class="grid sm:grid-cols-2 gap-3">
          {dishes.map(d => (
            <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
              <p class="font-bold text-brand-navy">{d.name}</p>
              <p class="text-sm text-gray-500 mt-0.5 leading-snug">{d.desc}</p>
            </div>
          ))}
        </div>
        <div class="mt-8">
          <a href="/menu/" class="inline-block px-7 py-3 bg-brand-navy hover:bg-[#243f52] text-white font-bold rounded-full shadow transition-colors">
            See the full menu &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Dine in / takeaway -->
    <section class="py-14" aria-labelledby="serve-heading">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 id="serve-heading" class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-8">Dine in or takeaway by the sea</h2>
        <div class="grid sm:grid-cols-2 gap-6">
          <div class="bg-sky-50 rounded-2xl p-6">
            <h3 class="font-bold text-brand-navy mb-2">🍽️ Eat in with a view</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Grab a table in our 1950s diner or out on the terrace and watch the boats work up the Deben while you eat.
              Dogs welcome inside and out.
            </p>
          </div>
          <div class="bg-sky-50 rounded-2xl p-6">
            <h3 class="font-bold text-brand-navy mb-2">🥡 Takeaway to the beach</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Prefer to eat outside? Take your <strong>takeaway fish &amp; chips</strong> down to the shingle beach at
              Felixstowe Ferry, just steps from the counter.
            </p>
          </div>
        </div>

        <!-- Serving times callout -->
        <div class="mt-8 bg-brand-navy text-white rounded-2xl p-6">
          <h3 class="font-bold text-sky-300 text-xs uppercase tracking-widest mb-3">Fish &amp; chips serving times</h3>
          <p class="text-sm leading-relaxed">
            Served <strong>from midday</strong>, with the kitchen open until 2pm.
            Open Wednesday to Friday 11am to 3pm, and Saturday &amp; Sunday 10am to 3pm.
            Closed Monday and Tuesday, except on bank holiday Mondays.
          </p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href="tel:+441394276305" class="text-xs font-semibold bg-white/15 hover:bg-white/25 px-4 py-2 rounded-full transition-colors">Call 01394 276305</a>
            <a href="/contact/" class="text-xs font-semibold bg-white/15 hover:bg-white/25 px-4 py-2 rounded-full transition-colors">Find us &amp; opening hours</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-gray-50 py-14" aria-labelledby="faq-heading">
      <div class="container mx-auto px-4 max-w-2xl">
        <h2 id="faq-heading" class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-8 text-center">Fish &amp; chips FAQs</h2>
        <dl class="space-y-6">
          {faqs.map(item => (
            <div class="border-b border-gray-200 pb-5">
              <dt class="font-bold text-brand-navy mb-1">{item.q}</dt>
              <dd class="text-sm text-gray-600 leading-relaxed">{item.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- CTA -->
    <section class="container mx-auto px-4 py-14 text-center" aria-label="Call to action">
      <h2 class="text-2xl font-bold text-gray-800 mb-3">Come for the fish &amp; chips</h2>
      <p class="text-gray-500 mb-7 max-w-md mx-auto text-sm sm:text-base">
        Find us at Felixstowe Ferry, Suffolk IP11 9RZ. Served from midday, Wednesday to Sunday.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/menu/" class="px-7 py-3 bg-primary hover:bg-sky-600 text-white font-bold rounded-lg shadow transition-colors">See Our Menu</a>
        <a href="https://maps.google.com/?q=The+Ferry+Cafe+Felixstowe+Ferry+IP11+9RZ" target="_blank" rel="noopener noreferrer" class="px-7 py-3 border-2 border-primary text-primary hover:bg-sky-50 font-bold rounded-lg transition-colors">Get Directions</a>
      </div>
    </section>

  </main>

  <!-- Mobile sticky bar -->
  <div class="fixed bottom-0 inset-x-0 z-50 sm:hidden bg-white border-t border-gray-200 shadow-2xl" aria-label="Quick contact">
    <div class="grid grid-cols-2 divide-x divide-gray-200">
      <a href="tel:+441394276305" class="flex items-center justify-center gap-2 py-3.5 text-primary font-bold text-sm active:bg-sky-50">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        Call Us
      </a>
      <a href="/menu/" class="flex items-center justify-center gap-2 py-3.5 bg-primary text-white font-bold text-sm active:bg-sky-600">
        See Menu
      </a>
    </div>
  </div>
  <div class="h-14 sm:hidden" aria-hidden="true"></div>
</Layout>
